#!/usr/bin/bash
# nvidia-kmod-guard: never make a kernel the boot default before its NVIDIA
# module (matching the installed NVIDIA userspace version) is installed.
#
#   nvidia-kmod-guard status   show every kernel and whether it has the module
#   nvidia-kmod-guard sync     fix the boot default (run by kernel-install and
#                              by an RPM file trigger; safe to run any time)
#
# It only acts when the newest kernel is the boot default, so a kernel you
# picked yourself with grubby is left alone.
set -uo pipefail

MODDIR=${NVIDIA_KMOD_GUARD_MODDIR:-/usr/lib/modules}
STATE=${NVIDIA_KMOD_GUARD_STATE:-/var/lib/nvidia-kmod-guard}
BOOT=${NVIDIA_KMOD_GUARD_BOOT:-/boot}
GRUBBY=${NVIDIA_KMOD_GUARD_GRUBBY:-grubby}
MODINFO=${NVIDIA_KMOD_GUARD_MODINFO:-modinfo}

log() { echo "nvidia-kmod-guard: $*" >&2; }

# Version of the installed NVIDIA userspace (empty if none is installed).
userspace_version() {
    if [[ -n ${NVIDIA_KMOD_GUARD_USERSPACE+x} ]]; then
        echo "$NVIDIA_KMOD_GUARD_USERSPACE"
        return
    fi
    rpm -q --qf '%{VERSION}\n' xorg-x11-drv-nvidia 2>/dev/null | grep -v 'not installed' | sort -V | tail -n1
}

# Installed kernels, newest first.
kernels() {
    local d
    for d in "$MODDIR"/*/; do
        [[ -e $d/vmlinuz ]] && basename "$d"
    done | sort -V -r
}

module_version() {
    local ko
    ko=$(compgen -G "$MODDIR/$1/extra/nvidia/nvidia.ko*" | head -n1)
    [[ -n $ko ]] && "$MODINFO" -F version "$ko" 2>/dev/null
}

default_kernel() {
    local k
    k=$("$GRUBBY" --default-kernel 2>/dev/null) || return
    echo "${k##*/vmlinuz-}"
}

set_default() {
    "$GRUBBY" --set-default "$BOOT/vmlinuz-$1" >/dev/null
}

cmd_status() {
    local want k have mark def
    want=$(userspace_version)
    def=$(default_kernel)
    echo "NVIDIA userspace: ${want:-not installed}"
    for k in $(kernels); do
        have=$(module_version "$k")
        mark="ok"
        [[ $have == "$want" ]] || mark="NO MODULE${have:+ (has $have)}"
        printf '%s %-40s %s\n' "$([[ $k == "$def" ]] && echo '*' || echo ' ')" "$k" "$mark"
    done
    [[ -f $STATE/held ]] && echo "Held back: $(cat "$STATE/held")"
    return 0
}

cmd_sync() {
    local want newest best k def
    want=$(userspace_version)
    [[ -n $want ]] || return 0           # no NVIDIA driver installed: nothing to guard
    newest=$(kernels | head -n1)
    [[ -n $newest ]] || return 0
    best=""
    for k in $(kernels); do
        if [[ $(module_version "$k") == "$want" ]]; then best=$k; break; fi
    done
    def=$(default_kernel)

    if [[ $newest != "$best" ]]; then
        if [[ -z $best ]]; then
            log "no installed kernel has the NVIDIA $want module; leaving the boot default alone"
            return 0
        fi
        if [[ $def == "$newest" ]]; then
            set_default "$best"
            mkdir -p "$STATE"
            echo "$newest" > "$STATE/held"
            log "kernel $newest has no NVIDIA $want module yet; booting $best until it arrives"
        fi
    elif [[ -f $STATE/held ]]; then
        if [[ $def != "$newest" ]]; then
            set_default "$newest"
            log "NVIDIA module for $newest is installed; it is the boot default again"
        fi
        rm -f "$STATE/held"
    fi
    return 0
}

case ${1:-status} in
    status) cmd_status ;;
    sync) cmd_sync ;;
    *) echo "usage: nvidia-kmod-guard [status|sync]" >&2; exit 2 ;;
esac
